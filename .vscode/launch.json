{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Balidaf: GUI (main.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Balidaf: procesar ejemplo (sin GUI)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": [
        "data/ejemplo.xlsx"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "preLaunchTask": "Generar Excel de ejemplo"
    },
    {
      "name": "Balidaf: procesar archivo elegido (sin GUI)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": [
        "${input:excelPath}"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Balidaf: procesar archivo + devolución SSS (sin GUI)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": [
        "${input:excelPath}",
        "--err",
        "${input:errPath}",
        "--informe"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ],
  "inputs": [
    {
      "id": "excelPath",
      "type": "promptString",
      "description": "Ruta del Excel a procesar"
    },
    {
      "id": "errPath",
      "type": "promptString",
      "description": "Ruta del TXT _DR.DEVOLUCION_ERR"
    }
  ]
}